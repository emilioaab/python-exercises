def make_warehouse(courses_dict, credits_dict, types):
    " Constructs a warehouse for courses, credits, and types."
    warehouse_courses = {}

    # Function to calculate the average grade for a given course type
    def avg_course_type(type_name):
        # Get the courses for the given type
        type_courses = types.get(type_name, [])
        # Get the grades for the courses
        type_grades = [courses_dict[course] for course in type_courses if course in courses_dict]
        # Return the average grade if there are any grades, else return None
        return sum(type_grades) / len(type_grades) if type_grades else None

    # Function to find the maximum grade for a given course type
    def max_course_type(type_name):
        # Get the courses for the given type
        type_grades = [courses_dict[course] for course in types.get(type_name, []) if course in courses_dict]
        # Return the maximum grade if there are any grades, else return None
        return max(type_grades) if type_grades else None

    # Function to find the minimum grade for a given course type
    def min_course_type(type_name):
        # Get the courses for the given type
        type_grades = [courses_dict[course] for course in types.get(type_name, []) if course in courses_dict]
        # Return the minimum grade if there are any grades, else return None
        return min(type_grades) if type_grades else None

    # Function to find the course with the minimum credits
    def min_credits():
        # Return the course with the minimum credits
        return courses_dict.get(min(credits_dict, key=credits_dict.get))

    # Function to find the course with the maximum credits
    def max_credits():
        # Return the course with the maximum credits
        return courses_dict.get(max(credits_dict, key=credits_dict.get))

    # Function to add a course to a given course type
    def add_course(name, grade, course_type):
        # If the course type exists, add the course to it
        # Else, print an error message
        types[course_type] = types[course_type] + (name,) \
            if course_type in types else print(
            "Course type does not exist.")
        # If the course type exists, add the grade to the course
        if course_type in types:
            courses_dict[name] = grade

    # Function to calculate the total average grade
    def average_total():
        # Calculate the total grade by summing the product of each course's grade and its credits
        total_grade = sum(
            courses_dict[course] * credits_dict[course] for course in courses_dict if course in credits_dict)
        # Calculate the total credits
        total_credits = sum(credits_dict.values())
        # Return the total grade divided by the total credits if there are any credits, else return None
        return total_grade / total_credits if total_credits else None

    # Add the functions to the dictionary
    warehouse_courses = {
        'min_course': min_course_type,
        'max_course': max_course_type,
        'avg_course': avg_course_type,
        'min_credits': min_credits,
        'max_credits': max_credits,
        'add_course': add_course,
        'average_total': average_total
    }
    # Return the dictionary
    return warehouse_courses


courses = (('a', 80), ('b', 95), ('c', 75), ('d', 58))
