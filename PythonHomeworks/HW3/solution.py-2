def make_rectangle(x, y, length, width):
    """
    Constructs a rectangle given its top-left corner coordinates (x, y),
    """

    def dispatch(method):   # dispatch is used instead of dispatch to avoid shadowing the built-in dispatch function
        if method == 'x':
            return x
        elif method == 'y':
            return y
        elif method == 'length':
            return length
        elif method == 'width':
            return width
        elif method == 'diagonal':
            return (length ** 2 + width ** 2) ** 0.5
        elif method == 'center':
            return (x + length / 2, y + width / 2)
        elif method == 'print':
            return f"Rectangle: point = ({x}, {y}); size = {length}x{width}"
        elif method == 'move':
            return lambda dx, dy: make_rectangle(x + dx, y + dy, length, width)
        elif method == 'resize':
            return lambda factor: make_rectangle(x, y, length * factor, width * factor)
        elif method == 'average':
            return lambda rect: make_rectangle(
                (x + rect('x')) / 2,
                (y + rect('y')) / 2,
                (length + rect('length')) / 2,
                (width + rect('width')) / 2
            )
        # More methods can be added here as needed.

    return dispatch


# Now the functions such as print_rectangle, move, resize, etc., can directly use the dispatch mechanism.
def print_rectangle(rectangle): # Print the rectangle
    print(rectangle('print'))


def move(rectangle, deltaX, deltaY): # Move the rectangle by a given delta
    return rectangle('move')(deltaX, deltaY)


def resize(rectangle, factor): # Resize the rectangle by a given factor
    return rectangle('resize')(factor)


def average_rectangle(rectangle1, rectangle2): # Calculate the average rectangle between two rectangles
    return rectangle1('average')(rectangle2)


def distance(rectangle1, rectangle2): # Calculate the distance between the centers of two rectangles
    center1 = rectangle1('center')
    center2 = rectangle2('center')
    return ((center1[0] - center2[0]) ** 2 + (center1[1] - center2[1]) ** 2) ** 0.5


# Example of using updated dispatch
r1 = make_rectangle(3, 4, 10, 26)
print(r1)
print(r1('x'))
print(r1('y'))
print(r1('length'))
print(r1('width'))
print(r1('diagonal'))
print_rectangle(r1)
print(r1('center'))
print(distance(r1, make_rectangle(6, 9, 5, 8)))
print_rectangle(move(r1, 2, -3))
print_rectangle(resize(r1, 0.5))
print_rectangle(move(resize(r1, 1.5), -8, 2))
r2 = make_rectangle(6, 9, 5, 8)
print_rectangle(average_rectangle(r1, r2))
print_rectangle(average_rectangle(move(r1, -1, -2), resize(average_rectangle(r2,
                                                                             make_rectangle(6, 9, 5, 8)), 2)))
print(average_rectangle(move(r1, -1, -2), resize(average_rectangle(r2, make_rectangle(6, 9, 5, 8)),
                                                 2)))

