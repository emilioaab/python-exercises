def sets(initial_elements=None):
    "Constructs a set with the given initial elements."
    if initial_elements is None:
        initial_elements = []
    set_elements = [False] * 21  # For integers 0-20
    for element in initial_elements:
        if 0 < element <= 20:
            set_elements[element] = True

    def dispatch(message, *args): # dispatch is used instead of dispatch to avoid shadowing the built-in dispatch function
        if message == 'add':
            element = args[0]
            if 0 < element <= 20:
                set_elements[element] = True
        elif message == 'remove':
            element = args[0]
            if 0 < element <= 20:
                set_elements[element] = False
        elif message == 'set':
            new_elements = args[0]
            for i in range(21):
                set_elements[i] = i in new_elements
        elif message == 'xor':
            other_set = args[0]
            return sets([i for i in range(21) if set_elements[i] != other_set('in', i)])
        elif message == '\\':
            other_set = args[0]
            return sets([i for i in range(21) if set_elements[i] and other_set('in', i)])
        elif message == '*':
            other_set = args[0]
            return sets([i for i in range(21) if set_elements[i] and not other_set('in', i)])
        elif message == '+':
            other_set = args[0]
            return sets([i for i in range(21) if set_elements[i] or other_set('in', i)])
        elif message == 'in':
            element = args[0]
            return 0 <= element <= 20 and set_elements[element]
        elif message == 'not in':
            element = args[0]
            return not (0 <= element <= 20 and set_elements[element])
        elif message == 'not':
            return sets([i for i, present in enumerate(set_elements) if not present])
        elif message == 'view':
            return {i for i, present in enumerate(set_elements) if present}
        # Add more operations here as needed, like union, intersection, difference

        else:
            raise ValueError("Unknown operation")

    return dispatch


# Example usage
s1 = sets((1, 2, 3, 4, 5, 100))
print(s1)
print(s1('view'))
print(s1('in', 3))
print(s1('not in', 31))
print(s1('not in', 3))
s2 = s1('not')
print(s2)
print(s2('view'))
s1('set', (1, 2, 3, 4, 5, 7, 9, 12, 17))
s2('set', (2, 4, 5, 10, 14, 16, 20))
print(s1('+', s2)('not')('view'))
print(s1('*', s2)('xor', s1('\\'
                            , sets((2, 3, 5, 12))))('view'))

