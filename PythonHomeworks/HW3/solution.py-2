def make_matrix(n, m, matrix_data):
    """
    Constructs a matrix given its dimensions n (rows) and m (columns),
    and matrix_data as a single list.
    """
    assert len(matrix_data) == n * m, "Invalid matrix dimensions."

    def get_item(row, col): # Get an item from the matrix
        assert 0 <= row < n and 0 <= col < m, "Row or column is out of bounds."
        return matrix_data[row * m + col]

    def print_matrix(): # Print the matrix
        for i in range(n):
            print(' '.join('{:4}'.format(item) for item in matrix_data[i * m:(i + 1) * m]))

    def dispatch(method, *args): # dispatch is used instead of dispatch to avoid shadowing the built-in dispatch function
        if method == 'get_item':
            return get_item(*args)
        elif method == 'print_matrix':
            return print_matrix()
        elif method == 'n':
            return n
        elif method == 'm':
            return m
        elif method == 'matrix':
            return matrix_data
        else:
            raise ValueError(f"Unknown method: {method}")

    return dispatch


def PrintMatrix(matrix): # Print the matrix
    matrix('print_matrix')


def AddMatrix(matrix1, matrix2): # Add two matrices
    assert matrix1('n') == matrix2('n') and matrix1('m') == matrix2('m'), "Matrices must have the same dimensions."
    matrix1_data = matrix1('matrix')
    matrix2_data = matrix2('matrix')
    result = [a + b for a, b in zip(matrix1_data, matrix2_data)]
    return make_matrix(matrix1('n'), matrix1('m'), result)


def TransposeMatrix(matrix): # Transpose a matrix
    n, m = matrix('n'), matrix('m')
    matrix_data = matrix('matrix')
    result = [matrix_data[j * m + i] for i in range(m) for j in range(n)]
    return make_matrix(m, n, result)


def MulMatrix(matrix1, matrix2):
    n1, m1 = matrix1('n'), matrix1('m')  # Dimensions of the first matrix
    n2, m2 = matrix2('n'), matrix2('m')  # Dimensions of the second matrix (after transposition if applied)
    assert m1 == n2, "Number of columns in the first matrix must be equal to the number of rows in the second matrix."

    # Initialize an empty list to store the result
    result = []
    for i in range(n1):  # Iterate over rows of the first matrix
        for j in range(m2):  # Iterate over columns of the second matrix
            total = 0
            for k in range(m1):  # Use m1 or n2 here, they should be the same
                # Update to access elements correctly using 'get_item' to avoid direct list access issues
                total += matrix1('get_item', i, k) * matrix2('get_item', k, j)
            result.append(total)

    # Return a new matrix with the result of multiplication
    return make_matrix(n1, m2, result)


m1 = make_matrix(2, 3, [1, 2, 3, 4, 5, 6])
print(m1)
print(m1('n'))
print(m1('m'))
print(m1('matrix'))
m2 = make_matrix(2, 3, [3, 4, 5, 6, 7, 8])
print('')
PrintMatrix(m1)
print('')
PrintMatrix(m2)
print('')
PrintMatrix(AddMatrix(m1, m2))
print('')
PrintMatrix(MulMatrix(m1, TransposeMatrix(AddMatrix(m1, m2))))

