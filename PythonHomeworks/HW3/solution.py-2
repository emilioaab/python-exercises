from functools import reduce


def avg_grades(courses):
    "Calculates the average grade for each course."
    # Use map and reduce to calculate the average grade for each course
    avg_grades_result = tuple(
        map(lambda course: (course[0], reduce(lambda a, b: a + b, course[1]) / len(course[1])), courses))
    return avg_grades_result


# Your provided course data
courses = (('a', [81, 78, 57]), ('b', [95, 98]), ('c', [75, 45]), ('d', [58]))

# Calculating and printing the average grades
average_grades = avg_grades(courses)
print("Average grades per course:")
print(average_grades)


def custom_round(number):
    # Split the number into its integer and fractional parts
    integer_part = int(number)
    fractional_part = number - integer_part

    # Apply the custom rounding rules
    if fractional_part < 0.5:
        # If the fractional part is below 0.5, round down
        rounded_number = integer_part
    elif fractional_part > 0.5:
        # If the fractional part is above 0.5, round up
        rounded_number = integer_part + 1
    else:
        # If the fractional part is exactly 0.5, keep it as 0.5
        rounded_number = integer_part + 0.5

    # Ensure the number is formatted to have one decimal place
    return float(f"{rounded_number:.1f}")


def add_factors(courses, factors):
    factors_dict = dict(factors)

    def adjust_grade(course):
        course_name, grades = course
        factor = factors_dict.get(course_name, 0)  # Default to 0 if no factor is specified for the course
        # Adjust grades with the factor, ensuring they do not exceed 100, and apply custom rounding
        adjusted_grades = list(map(lambda grade: custom_round(min(grade + factor, 100)), grades))
        # Filter out grades that are more than 100 after adjustment
        valid_grades = list(filter(lambda grade: grade <= 100, adjusted_grades))
        # Calculate the new average, ensuring to apply custom rounding to the result as well
        new_avg = custom_round(sum(valid_grades) / len(valid_grades)) if valid_grades else 0
        return course_name, new_avg

    # Apply grade adjustment to each course and calculate new averages using map
    adjusted_averages = tuple(map(adjust_grade, courses))
    return adjusted_averages


# Provided course data and factors
courses = (('a', [81, 78, 57]), ('b', [95, 98]), ('c', [75, 45]), ('d', [58]))
factors = (('c', 15), ('a', 20))

# Calculating and printing the adjusted average grades
adjusted_average_grades = add_factors(courses, factors)
print("Adjusted average grades per course:")
print(adjusted_average_grades)


def total_average(avg_grades, credits):
    credits_dict = dict(credits)
    # Use reduce to calculate the weighted sum of grades and total credits
    weighted_sum, total_credits = reduce(lambda acc, grade_info: (
        acc[0] + grade_info[1] * credits_dict.get(grade_info[0], 0), acc[1] + credits_dict.get(grade_info[0], 0)),
                                         avg_grades, (0, 0))
    weighted_average = weighted_sum / total_credits if total_credits else 0
    return weighted_average


# Example usage
courses = (('a', [81, 78, 57]), ('b', [95, 98]), ('c', [75, 45]), ('d', [58]))
credits = (('b', 2.5), ('d', 4), ('c', 3.5), ('a', 5))
average_grades = avg_grades(courses)
# Calculating the total weighted average grade
print(f"Weighted average grade:", total_average(avg_grades(courses), credits))

