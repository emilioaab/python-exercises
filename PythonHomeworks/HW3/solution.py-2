def make_sequence(seq):
    " Constructs a sequence from the given list."

    def _filter_(func=None): # _filter_ is used instead of filter to avoid shadowing the built-in filter function
        return seq if func is None else tuple(filter(func, seq))

    def filter_iterator(func): # filter_iterator is used instead of filter to avoid shadowing the built-in filter function
        filtered_seq = _filter_(func)
        reversed_filtered_seq = make_sequence(filtered_seq)('reverse')()

        index, reverse_index = -1, -1

        def _next_(): # _next_ is used instead of next to avoid shadowing the built-in next function
            nonlocal index
            index = (index + 1) % len(filtered_seq)
            return filtered_seq[index]

        def _reverse_(): # _reverse_ is used instead of reverse to avoid shadowing the built-in reverse function
            nonlocal reverse_index
            reverse_index = (reverse_index + 1) % len(reversed_filtered_seq)
            return reversed_filtered_seq[reverse_index]

        def dispatch(msg): # dispatch is used instead of dispatch to avoid shadowing the built-in dispatch function
            return _next_() if msg == 'next' else _reverse_() if msg == 'reverse' else None

        return dispatch

    def reverse(): # reverse is used instead of reverse to avoid shadowing the built-in reverse function
        return seq[::-1]

    def extend(seq2): # extend is used instead of extend to avoid shadowing the built-in extend function
        nonlocal seq
        seq = seq + seq2

    def dispatch(msg): # dispatch is used instead of dispatch to avoid shadowing the built-in dispatch function
        if msg == 'filter':
            return _filter_
        if msg == 'filter_iterator':
            return filter_iterator
        if msg == 'reverse':
            return reverse
        if msg == 'extend':
            return extend

    return dispatch


s1 = make_sequence((1, 2, 3, 4, 5))
print(s1)
p1 = s1('filter_iterator')(lambda x: x < 4)
print(p1)

for _ in range(5):
    print(p1('next'))
print('')
print("Reversed:")
for _ in range(4):
    print(p1('reverse'))
print('')
s1('extend')(s1('filter')(lambda x: x % 2 != 0))
print(s1('filter')(lambda x: x > 2))
print('')
print(s1('filter')())
print('')
print(make_sequence(s1('reverse')())('filter')(lambda x: x < 4))
